#!/bin/bash
# payload/handoff-sessions — shipped by amap-deploy-sandy and copied VERBATIM
# onto the feature payload beside the relay, which points the delivery daemon
# at it as AMAP_DELIVERY_SESSION_SOURCE. Edit it HERE, then re-run
# install --apply; an edit to a deployed copy is drift.
#
# It enumerates the live agent sessions in this container, one row per pane:
#
#   agent<TAB>pane_index<TAB>pane_pid<TAB>agent_pid<TAB>socket<TAB>keyfile
#
# with "-" for a value that does not apply. The daemon injects only into a
# `claude` row, through its socket and key file, and refuses when there is
# more than one (amap-connector-claude, bin/inbox-delivery).
#
# PANE IDENTITY is sandy's published pane-identity contract, and nothing else:
#   1. the tmux session is the literal "sandy", with one window;
#   2. sandy sets the pane option @sandy_pane_agent, naming its agent, on
#      every pane it creates, in single- and multi-agent mode (2.4.0+). A pane
#      without it is not sandy's: a user split, or a pane an agent opened,
#      such as an agent-teams teammate. Sandy before 2.4.0 set it in
#      multi-agent mode only, and there a single-agent pane's agent is
#      $SANDY_AGENT;
#   3. $SANDY_AGENT (comma-separated) is spawn order;
#   4. pane_index is NOT spawn order in the four-agent grid.
# So identity is read from the option, never from pane_index, a scrollback
# marker or the pane title. A pane without the option gets no row, except
# the sole pane of a single-agent session, which is $SANDY_AGENT. So when any
# pane carries the option only the options identify, and no version is read.
#
# A process in the session can rewrite or clear the option. That can only
# stop delivery into this sandbox (two claude rows, or none), never redirect
# it.
#
# The socket and key-file locations are Claude Code's, not sandy's. Claude Code
# uses /tmp/cc-socks, and falls back to a private /tmp/cc-socks-<uid> when it
# cannot use that; both are searched, the default first. The socket's own
# variable is set only in claude's children, not in its environment, so it
# cannot be read from the process.
#
# A PARKED SESSION IS FOLLOWED TO ITS SUCCESSOR. When a conversation is sent
# to the background, the pane's claude stays alive and keeps its socket, but
# it is parked: Claude Code's session file for it ($KEY_DIR/<pid>.json)
# carries `parkedJobId`, and the conversation continues in the session whose
# file carries the same `jobId`. A parked session accepts a frame and queues
# it unread, so the row names the successor instead: its pid, socket and key
# file. The successor must be the only session file carrying that jobId,
# descend from the pane and have a socket, or it is not followed. A parked
# session whose successor cannot be resolved gets NO row: the daemon waits and re-polls, and nothing is recorded as delivered.
# Both fields are Claude Code internals, not a published contract. A missing
# session file reads as "not parked" (the pane's session is the
# conversation); one that exists but does not parse gets no row this poll.
# Each decision other than "not parked" is said on stderr, which the daemon
# does not log when the lister succeeds; run the file by hand to see it.
#
# This file sits behind the read-only payload mount with the rest of the
# relay chain: the daemon execs it, so it must be no more writable than the
# daemon itself.
set -uo pipefail

PROC=/proc
SOCK_DIRS="/tmp/cc-socks /tmp/cc-socks-$(id -u)"
KEY_DIR="$HOME/.claude/sessions"
SESSION=sandy
TAB="$(printf '\t')"

panes() {
    tmux list-panes -t "$SESSION" -F "#{pane_index}${TAB}#{pane_pid}${TAB}#{@sandy_pane_agent}" 2>/dev/null || true
}

ppid_of() { local l; l="$(cat "$PROC/$1/stat" 2>/dev/null)" || return 1; l="${l##*) }"; set -- $l; echo "$2"; }
comm_of() { local l; l="$(cat "$PROC/$1/stat" 2>/dev/null)" || return 1; l="${l#*(}"; echo "${l%%)*}"; }

sock_of() {  # $1 pid: its messaging socket, from the first directory holding one
    local dir
    for dir in $SOCK_DIRS; do
        [ -S "$dir/$1.sock" ] && { echo "$dir/$1.sock"; return 0; }
    done
    return 1
}

is_agent() {  # $1 pid, $2 agent name
    [ "$(comm_of "$1")" = "$2" ] && return 0
    # Process substitution, not a `tr | grep -q` pipe: under pipefail, grep -q
    # can match and exit while tr is still writing, and tr's SIGPIPE (141)
    # would become the pipeline's status and hide a real match on a long
    # command line.
    grep -qxE "(.*/)?$2" < <(tr '\0' '\n' < "$PROC/$1/cmdline" 2>/dev/null)
}

descendants() {  # breadth-first over $PROC; prints pids nearest first
    local q="$1" cur d
    while [ -n "$q" ]; do
        cur="${q%% *}"; q="${q#"$cur"}"; q="${q# }"
        for d in "$PROC"/[0-9]*; do
            d="${d##*/}"; [ "$(ppid_of "$d" 2>/dev/null)" = "$cur" ] || continue
            echo "$d"; q="$q $d"
        done
    done
}

# $1 a session pid. Prints one line: `live`, `follow <pid>` (its successor,
# by the session files alone), or `none <reason>`. A successor that is itself
# parked is followed again, a bounded number of times.
park_state() {
    python3 -I - "$KEY_DIR" "$1" <<'PY'
import json, os, sys
keydir, pid = sys.argv[1], sys.argv[2]

def read(p):
    try:
        with open(os.path.join(keydir, f"{p}.json"), encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        raise SystemExit(f"none session file for {p} does not parse: {e}")

def successors(job):
    found = []
    for name in sorted(os.listdir(keydir)):
        stem, ext = os.path.splitext(name)
        if ext != ".json" or not stem.isdigit():
            continue
        try:
            with open(os.path.join(keydir, name), encoding="utf-8") as f:
                doc = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(doc, dict) and doc.get("jobId") == job and str(doc.get("pid")) == stem:
            found.append(stem)
    return found

cur, seen = pid, set()
while True:
    doc = read(cur)
    job = doc.get("parkedJobId") if isinstance(doc, dict) else None
    if not job:
        print("live" if cur == pid else f"follow {cur}")
        break
    seen.add(cur)
    found = successors(job)
    if len(found) != 1:
        print(f"none {cur} is parked as job {job} and "
              + (f"{len(found)} session files carry that jobId ({', '.join(found)})"
                 if found else "no session file carries that jobId"))
        break
    nxt = found[0]
    if nxt in seen or len(seen) > 8:
        print(f"none the parked sessions from {pid} form a loop")
        break
    cur = nxt
PY
}

is_descendant() {  # $1 pid, $2 ancestor pid
    local p="$1"
    while [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null; do
        p="$(ppid_of "$p")" || return 1
        [ "$p" = "$2" ] && return 0
    done
    return 1
}

IFS=',' read -ra ORDER <<< "${SANDY_AGENT:-claude}"
rows="$(panes)"; [ -n "$rows" ] || exit 0
count="$(printf '%s\n' "$rows" | grep -c .)"

# Rows are emitted in spawn order, matched by the option; pane_index is only
# reported.
for a in "${ORDER[@]}"; do
    while IFS="$TAB" read -r idx ppid tag; do
        [ -n "${idx:-}" ] || continue
        if [ -z "$tag" ]; then
            # Untagged: identified only as the sole pane of a single-agent
            # session, which is then untagged throughout (sandy before 2.4.0).
            # Any other untagged pane is a user split or a teammate.
            [ "${#ORDER[@]}" -eq 1 ] && [ "$count" -eq 1 ] || continue
            tag="${ORDER[0]}"
        fi
        [ "$tag" = "$a" ] || continue
        apid="-"; sock="-"; key="-"
        for d in $(descendants "$ppid"); do
            is_agent "$d" "$a" || continue
            if [ "$a" = "claude" ] && sock_of "$d" >/dev/null; then apid="$d"; break; fi
            [ "$apid" = "-" ] && apid="$d"
        done
        if [ "$a" = "claude" ] && [ "$apid" != "-" ] && sock_of "$apid" >/dev/null; then
            state="$(park_state "$apid" 2>&1)"
            case "$state" in
                live) ;;
                follow\ *)
                    next="${state#follow }"
                    if is_descendant "$next" "$ppid" && is_agent "$next" claude \
                            && sock_of "$next" >/dev/null; then
                        echo "handoff-sessions: $apid is parked; its successor $next takes the row" >&2
                        apid="$next"
                    else
                        echo "handoff-sessions: $apid is parked; its successor $next is not a live claude with a socket under this pane, so no row" >&2
                        continue
                    fi ;;
                *)
                    echo "handoff-sessions: no row for $apid: ${state#none }" >&2
                    continue ;;
            esac
        fi
        if [ "$a" = "claude" ] && [ "$apid" != "-" ]; then
            sock=$(sock_of "$apid") || sock="-"
            for k in "$KEY_DIR/$apid".*.key; do [ -f "$k" ] && { key="$k"; break; }; done
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$a" "$idx" "$ppid" "$apid" "$sock" "$key"
    done <<< "$rows"
done
